# Copy to .env and fill in ONE provider key to run. .env is gitignored —
# never commit real keys.

# Experiment tracking (W&B runs log to entity=tuminha, project=dental-llm-benchmark)
WANDB_API_KEY=

# --- Pick a backend by which key you have ---

# Full cross-provider benchmark, one key reaches every model (default backend):
#   python src/run_eval.py --trials 3
OPENROUTER_API_KEY=

# OpenAI / GPT family incl. GPT-5.5:
#   python src/run_eval.py --backend openai --trials 3
OPENAI_API_KEY=

# Claude family:
#   python src/run_eval.py --backend anthropic --trials 3
ANTHROPIC_API_KEY=

# Legacy notebooks (legacy/) only
GROQ_API_KEY=
TOGETHER_API_KEY=
