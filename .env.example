# Copy to .env and fill in only the providers you want to benchmark.
# .env is gitignored — never commit real keys.

# Experiment tracking (W&B runs log to entity=tuminha, project=dental-llm-benchmark)
WANDB_API_KEY=

# Full cross-provider benchmark — one key reaches every model (default backend)
OPENROUTER_API_KEY=

# Claude-family pilot — `python src/run_eval.py --backend anthropic` uses this directly
ANTHROPIC_API_KEY=

# Legacy notebooks (legacy/) only
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENAI_API_KEY=
