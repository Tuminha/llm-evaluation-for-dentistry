    given-names: "Francisco"
    affiliation: "Periospot; Foundation for Oral Rehabilitation"
    orcid: ""
keywords:
  - dentistry
  - periodontics
  - large language models
  - LLM evaluation
  - benchmark
  - clinical decision support
license: MIT
